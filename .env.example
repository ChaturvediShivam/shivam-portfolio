# Cloudflare Turnstile (free at cloudflare.com)
# Used to protect the contact form from spam.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_secret_key_here

# Resend (https://resend.com) — email delivery for contact form submissions
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=portfolio@your-domain.com
CONTACT_RECIPIENT_EMAIL=your_email@example.com

# Supabase (https://supabase.com) — inquiry storage + admin dashboard auth
# Run supabase/schema.sql in your project's SQL editor once, and create one
# admin user under Authentication > Users (email + password) — that's the
# only login the /admin dashboard will accept.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------------------
# Phase 3 — background jobs, integrations and AI
# ---------------------------------------------------------------------------
# Every capability below ships behind a feature flag that defaults OFF. A flag
# is on only when its value is exactly the string "true"; anything else is off.
# Flipping one off is the first-line rollback and needs no redeploy.

# Feature flags
FEATURE_JOBS=false
FEATURE_GOOGLE_OAUTH=false
FEATURE_GMAIL_SYNC=false
FEATURE_CALENDAR=false
FEATURE_NOTIFICATIONS=false
FEATURE_AI=false
FEATURE_AI_SUMMARIES=false
# Copilot (M8). Requires FEATURE_AI: the assistant streams through the gateway.
FEATURE_ASSISTANT=false
# AI email drafting (M9). Requires FEATURE_AI. Enabling it also requests the
# Gmail send scope on the next connect — reconnect Google after turning it on.
FEATURE_EMAIL_DRAFTING=false
# Workflow automation (M10). Rules ship disabled; `enabled=false` per rule is
# the finer-grained kill switch, this flag is the global one.
FEATURE_AUTOMATION=false
# AI Inbox Assistant: on-demand triage digest over recent inbound mail.
# Requires FEATURE_AI. Computes nothing until the operator asks; no storage.
FEATURE_INBOX_ASSISTANT=false
# Resume AI enrichment (Phase 3 · Step 2). Requires FEATURE_AI. The deterministic
# score works with this off; only the AI review, rewrite, LinkedIn copy,
# interview questions and cover letter are gated.
FEATURE_RESUME_AI=false
# Public Resume AI demo at /demo. Requires FEATURE_AI and FEATURE_RESUME_AI.
# This is the only flag that exposes a billed provider call to unauthenticated
# traffic, so it stays off until DEMO_OWNER_ID and the demo budget below are
# both set. Turning it off is the first-line rollback for demo abuse.
FEATURE_PUBLIC_DEMO=false

# ---------------------------------------------------------------------------
# Public demo (/demo)
# ---------------------------------------------------------------------------
# The demo has no session, but every existing safety layer — the token budget,
# the AI rate limiter and the audit log — is keyed on an owner id that is a
# FOREIGN KEY into auth.users (verified against the deployed database:
# ai_usage_counters_owner_id_fkey rejects a synthetic uuid with SQLSTATE 23503).
# So the demo needs one real, dedicated Supabase user to own its usage. Create
# it under Authentication > Users with an address that is NOT in
# ADMIN_SIGNUP_ALLOWLIST — otherwise isAdminEmail() would treat demo traffic as
# an administrator — then paste its uuid here.
#
# A dedicated owner also keeps demo spend off your personal daily ceiling.
DEMO_OWNER_ID=uuid_of_the_dedicated_demo_user

# Daily token ceiling for demo traffic only, enforced by the same atomic
# ai_reserve_budget path as AI_DAILY_TOKEN_BUDGET. Keep it well below that value:
# this one is spent by strangers. Exhausting it degrades the demo to its
# deterministic score rather than breaking the page.
AI_DEMO_DAILY_TOKEN_BUDGET=50000

# Salt for hashing visitor IPs in the per-visitor throttle. The limiter only
# needs equality, never the address, so the raw IP is never stored. Rotating
# this resets every visitor's window.
DEMO_IP_SALT=generate_a_long_random_string

# Background jobs (M1) — the cron drainer authenticates with this shared secret.
CRON_SECRET=generate_a_long_random_string
# Encrypts OAuth tokens at rest. Rotating it invalidates stored tokens.
TOKEN_ENCRYPTION_KEY=generate_a_32_byte_base64_key

# Google OAuth (M2) — Gmail + Calendar. Redirect URI must be allow-listed.
GOOGLE_OAUTH_CLIENT_ID=your_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain/api/integrations/google/callback

# AI provider (M6). The key is server-only and is never sent to the client.
AI_PROVIDER_API_KEY=your_provider_api_key
# Optional: selects the adapter. Unknown values fail closed.
AI_PROVIDER=anthropic

# Per-owner daily token ceiling. REQUIRED before enabling FEATURE_AI_SUMMARIES:
# unset means unlimited, and automatic summarization spends without a human in
# the loop. The ingest and backfill paths refuse to enqueue while it is unset.
AI_DAILY_TOKEN_BUDGET=500000

# Cost levers. Summaries use the `fast` class, which defaults to the provider's
# strongest (and most expensive) model. SET THIS before enabling summaries —
# nothing in code enforces it, and the default costs roughly 5x.
AI_MODEL_FAST=claude-haiku-4-5
AI_EFFORT_FAST=low
# Used by the `reasoning` class (no consumer until M8).
AI_MODEL_REASONING=
AI_EFFORT_REASONING=
