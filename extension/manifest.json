{
  "manifest_version": 3,
  "name": "CareerCRM Capture",
  "version": "1.0.0",
  "description": "Capture a job posting from any page and save it to CareerCRM after reviewing it.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.shivamchaturvedi.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Capture to CareerCRM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
