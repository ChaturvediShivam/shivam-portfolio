.vercel
# Real environment files never enter version control.
.env
.env.*
# The template does — it documents required variables and holds placeholders only.
!.env.example
node_modules
.next
out
tsconfig.tsbuildinfo
.DS_Store
Thumbs.db
*.log

# Supabase CLI scratch state (link info, versions) — machine-local.
supabase/.temp/

# Vitest coverage output — regenerated by `vitest --coverage` on demand.
coverage/

# Generated by scripts/copy-pdf-worker.mjs on every build — never edit or commit.
public/pdf.worker.min.mjs

# Browser "print page to PDF" captures of docs. The markdown is the source and
# is committed; a 43 MB render of it nearly went into history once.
docs/**/screencapture-*.pdf
